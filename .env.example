APP_NAME="Dream Digital"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8888

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# OpenAI content generation (Admin > Pages > Generate Article)
# Provider `local` keeps a deterministic fallback. Use `openai` after adding a key.
DD_ARTICLE_GENERATOR_PROVIDER=local
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5-mini
OPENAI_TIMEOUT=45
OPENAI_MAX_OUTPUT_TOKENS=9000
OPENAI_FALLBACK_ON_FAILURE=true

# Dream Digital Sprint 1
APP_AVAILABLE_LOCALES=fr,en
FX_API_URL=https://api.frankfurter.app/latest
FX_CACHE_HOURS=6
SALES_EMAIL_GLOBAL=sales@dream-digital.info
SALES_EMAIL_CD=sales.cd@dream-digital.info
SALES_EMAIL_CG=sales.cg@dream-digital.info
SALES_EMAIL_CI=sales.ci@dream-digital.info
PHOENIX_BASE_URL=
PHOENIX_ADMIN_USERNAME=
PHOENIX_ADMIN_PASSWORD=
PHOENIX_DRY_RUN=false

# Admin back-office credentials (utilises par AdminUserSeeder)
# Le seeder ne cree PAS d'admin si DD_ADMIN_PASSWORD est vide.
# Pour creer/maj l'admin : definir ces vars puis lancer
#   php artisan db:seed --class=AdminUserSeeder
DD_ADMIN_EMAIL=admin@dream-digital.info
DD_ADMIN_NAME="Admin Dream Digital"
DD_ADMIN_PASSWORD=

# Donnees business obligatoires pour `php artisan dd:launch-check --public`
DD_SALES_EMAIL=sales@dream-digital.info
DD_SUPPORT_EMAIL=support@dream-digital.info
DD_SECURITY_EMAIL=security@dream-digital.info
DD_PRIVACY_EMAIL=privacy@dream-digital.info
DD_PUBLIC_PHONE=
DD_COMPANY_LEGAL_NAME=
DD_OG_IMAGE=/img/brand/logo-dd-horizontal.png
DD_SOCIAL_LINKEDIN=
DD_SOCIAL_TWITTER=
DD_SOCIAL_GITHUB=

# Indexation publique. Bascule a `true` UNIQUEMENT apres :
#  1. Validation visuelle PO complete (toutes pages publiques + admin)
#  2. Validation juridique des pages legales (mentions, CGU, RGPD)
#  3. Configuration finale du sitemap (declare a Google Search Console)
#
# Effets quand true :
#  - <meta name="robots" content="index, follow">
#  - /robots.txt -> User-agent: * + Allow: / + Sitemap: <APP_URL>/sitemap.xml
#  - /sitemap.xml -> XML sitemap valide listant ~35 URLs publiques
#
# Effets quand false (defaut) :
#  - <meta name="robots" content="noindex, nofollow">
#  - /robots.txt -> Disallow: /
#  - /sitemap.xml -> 410 Gone
DD_PUBLIC_INDEXABLE=false

# Public launch confirmations (used by `php artisan dd:launch-check --public`)
DD_ADMIN_PASSWORD_ROTATED=false
DD_LEGAL_VALIDATED=false
DD_PUBLIC_BASIC_AUTH_DISABLED=false
DD_BACKUPS_CONFIGURED=false
DD_ENV_BACKED_UP=false
DD_DEPLOYMENT_RUNBOOK_REVIEWED=false

# Database backup guard. In production, run `php artisan dd:backup-db`
# before migrations; `dd:launch-check --public` expects a recent dump.
DD_DB_BACKUP_PATH=
DD_MYSQLDUMP_BINARY=mysqldump
DD_DB_BACKUP_MAX_AGE_HOURS=24
DD_REQUIRE_RECENT_DB_BACKUP=true

# Observability/security hardening
DD_REQUEST_ID_HEADER=X-Request-Id
DD_SLOW_REQUEST_MS=1000
DD_CSP_ENABLED=true
DD_CSP_REPORT_ONLY=true
DD_CSP_REPORT_URI=
DD_SECURITY_TXT_EXPIRES_DAYS=30
